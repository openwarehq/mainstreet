{
  "name": "mainstreet",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-4340}",
    "build": "next build",
    "start": "next start -p ${PORT:-4340}",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "design:one": "tsx --env-file-if-exists=.env.local scripts/design-one.mts",
    "brief": "tsx --env-file-if-exists=.env.local scripts/brief.mts",
    "place": "tsx --env-file-if-exists=.env.local scripts/place.mts",
    "capture": "tsx --env-file-if-exists=.env.local scripts/capture.mts"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
